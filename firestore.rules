rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // IMPORTANT: keep this list identical to window.ADMIN_EMAILS in
    // firebase-config.js. Firestore rules cannot read a JS file, so the
    // admin list must be duplicated here. If you add/remove an admin in
    // one place, update the other and re-publish these rules.
    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        "naowadee.k@gmail.com"
        // , "another.admin@example.com"
      ];
    }

    // Departments: everyone signed in can read the list (so the
    // dropdown / filters work), but only admins can create, rename
    // or delete a department.
    match /departments/{deptId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Areas (พื้นที่ที่พบ): same pattern as departments — everyone
    // signed in can read the list, only admins manage it.
    match /areas/{areaId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Observations: any signed-in user can create and read (needed
    // for shared dashboards/reports). Updates (e.g. action-plan
    // follow-up, or editing from Dashboard/Reports) are allowed to
    // any signed-in user, since collaborators follow up on each
    // other's items. Only the original creator (or an admin) may
    // delete.
    match /observations/{obsId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // User profiles: each user can read any profile (needed to show
    // names in reports/submitters list) but can only write their own.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
  }
}
